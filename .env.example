# ---- Backend ----
# Admin portal credentials (change these in production)
ADMIN_EMAIL=admin@tradeforge.pro
ADMIN_PASSWORD=AdminPass123!

# How long a session lasts before the user must sign in again (hours).
# Default 168 = 7 days. Sessions are stored in the database, so they
# survive server/container restarts.
SESSION_TTL_HOURS=168

# Optional absolute path to the SQLite database file.
# Leave empty to use backend/tradeforge.db
DATABASE_PATH=

# ---- Frontend ----
# Base URL of the backend API (dev only, used by the vite dev server).
# In production the built SPA is served by the same server, so this can be left unset.
VITE_API_URL=http://127.0.0.1:8000
